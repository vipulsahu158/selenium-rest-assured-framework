<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  parallel="tests"            -> every <test> block (one per browser, plus API) runs at the same time
  thread-count="4"            -> 3 browsers + 1 API block
  data-provider-thread-count  -> data rows inside each block (Excel rows) also run concurrently
  Total browsers open at once is roughly 3 x data-provider-thread-count; lower it on small machines.
-->
<suite name="UI and API Automation Suite" parallel="tests" thread-count="4" data-provider-thread-count="3">

    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
        <listener class-name="com.framework.listeners.RetryTransformer"/>
    </listeners>

    <test name="UI - Chrome">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="com.framework.tests.ui.*"/>
        </packages>
    </test>

    <test name="UI - Firefox">
        <parameter name="browser" value="firefox"/>
        <packages>
            <package name="com.framework.tests.ui.*"/>
        </packages>
    </test>

    <test name="UI - Edge">
        <parameter name="browser" value="edge"/>
        <packages>
            <package name="com.framework.tests.ui.*"/>
        </packages>
    </test>

    <test name="API Tests">
        <packages>
            <package name="com.framework.tests.api"/>
        </packages>
    </test>

</suite>
