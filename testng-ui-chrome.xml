<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- Single-browser UI run: mvn test -DsuiteXmlFile=testng-ui-chrome.xml -Dheadless=true -->
<suite name="UI Suite - Chrome" data-provider-thread-count="4">
    <listeners>
        <listener class-name="com.framework.listeners.TestListener"/>
    </listeners>
    <test name="UI - Chrome">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="com.framework.tests.ui"/>
        </packages>
    </test>
</suite>
